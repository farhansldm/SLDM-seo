NODE_ENV=production
PORT=4000

# Keep this relative when the Node server serves both the API and dist folder.
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME="SEO Agency Platform"

DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"
VITE_SUPABASE_URL="https://PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"

# Replace this with the exact HTTPS test-domain origin. Same-origin deployments
# normally need only this entry.
CORS_ORIGINS="https://test.example.com"
TRUST_PROXY=true

AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
JOB_MODE=inline
DATA_MODE=live
CRAWL_MAX_PAGES=25
CRAWL_TIMEOUT_MS=10000
CRAWL_MAX_RESPONSE_BYTES=2000000
REPORT_STORAGE_DIR="storage/reports"
PUPPETEER_EXECUTABLE_PATH=
JSON_BODY_LIMIT="1mb"

# Mock keeps the test deployment usable without paid AI calls.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-6-astra"
AI_REQUEST_TIMEOUT_MS=45000
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000
